# --- Application ---
APP_NAME=aviator_web
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# --- Security ---
SECRET_KEY=change-me-to-random-32-chars-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Database ---
DATABASE_URL=postgresql+asyncpg://aviator:aviator@localhost:5432/aviator_web

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Booking provider (Этап 1) ---
PROVIDER=travelpayouts
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=
