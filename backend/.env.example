# --- Application ---
APP_NAME=aviator_web
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# --- Security ---
SECRET_KEY=change-me-to-random-32-chars-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Ключ для PATCH /orders/{ref}/status (менеджерская ручка). Пока нет ролей
# в личном кабинете — временная защита. Сгенерируй случайную строку и
# передавай её в заголовке X-Manager-Key.
MANAGER_API_KEY=

# Куда слать копию нового обращения в поддержку (см. /admin). Пусто — письмо
# уйдёт только клиенту, обращение всё равно видно в панели оператора.
SUPPORT_NOTIFY_EMAIL=

# --- Вход через Google (OAuth 2.0 Client ID, тип Web application) ---
# Authorized redirect URI в Google Cloud Console должен совпадать с GOOGLE_REDIRECT_URI.
# Пока пусто — email+пароль работает, кнопка "Войти через Google" вернёт понятную ошибку.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --- Database ---
DATABASE_URL=postgresql+asyncpg://aviator:aviator@localhost:5433/aviator_web

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Rate limiting auth-эндпоинтов (счётчики в Redis) ---
# По умолчанию включено и уже настроено разумными порогами — в dev ничего
# донастраивать не нужно. AUTH_RATE_LIMIT_ENABLED=false — выключить целиком
# (например, для нагрузочного тестирования).
AUTH_RATE_LIMIT_ENABLED=true
AUTH_LOGIN_RATE_LIMIT=10
AUTH_LOGIN_RATE_LIMIT_WINDOW=300
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REGISTER_RATE_LIMIT_WINDOW=3600
AUTH_PASSWORD_RESET_RATE_LIMIT=3
AUTH_PASSWORD_RESET_RATE_LIMIT_WINDOW=3600
AUTH_CODE_VERIFY_RATE_LIMIT=5
AUTH_CODE_VERIFY_RATE_LIMIT_WINDOW=3600
AUTH_GOOGLE_CALLBACK_RATE_LIMIT=30
AUTH_GOOGLE_CALLBACK_RATE_LIMIT_WINDOW=600

# --- CORS ---
CORS_ORIGINS=http://localhost:3000

# --- Booking provider (Этап 1) ---
PROVIDER=travelpayouts
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# --- Почта для ценовых подписок (Этап 2) ---
# Пока SMTP_HOST пуст, письма не уходят наружу, а печатаются в лог.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Aviator <noreply@aviatour.travel>
SMTP_USE_TLS=true

# --- Воркер ценовых подписок ---
PRICE_WATCH_INTERVAL_SECONDS=1800
PRICE_WATCH_BATCH=50
SITE_URL=http://localhost:3000

# --- ЮKassa (P6). Пусто — оплата не списывается, заявка остаётся «ожидает оплаты». ---
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:3000/order
